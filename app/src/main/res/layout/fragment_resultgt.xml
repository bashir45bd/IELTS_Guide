<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@color/color1"
      android:gravity="center"
      >

    <LinearLayout
        android:layout_width="@dimen/_250sdp"
        android:layout_height="@dimen/_40sdp"
        android:orientation="horizontal"
        android:background="@drawable/two_color2"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginTop="@dimen/_10sdp"
        android:elevation="@dimen/_5sdp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/kalpurush"
            android:text="Reading Band Score"
            android:textColor="@color/white"
            android:textSize="@dimen/_22ssp"
            android:textStyle="bold"

            />

    </LinearLayout>

      <com.google.android.material.textfield.TextInputLayout
          android:layout_width="@dimen/_250sdp"
          android:layout_height="wrap_content"
          style="@style/ThemeOverlay.Material3.AutoCompleteTextView"
          android:hint="Out of 40"
          android:layout_marginTop="@dimen/_7sdp"
          app:endIconMode="clear_text"
          app:boxStrokeWidth="@dimen/_2sdp"
          app:boxBackgroundColor="@color/white"
          android:paddingLeft="@dimen/_2sdp"
          android:paddingRight="@dimen/_2sdp"
          android:paddingTop="@dimen/_1sdp"
          android:paddingBottom="@dimen/_4sdp"
          android:background="@drawable/ac1"
          >

          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/gttext1"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="number"
              android:maxLength="2"
              android:textColor="#151515"
              android:textSize="@dimen/_13ssp" />


      </com.google.android.material.textfield.TextInputLayout>

      <LinearLayout
          android:layout_width="@dimen/_250sdp"
          android:layout_height="@dimen/_40sdp"
          android:layout_gravity="center"
          android:layout_marginTop="@dimen/_15sdp"
          android:gravity="center"
          android:orientation="horizontal">

          <TextView
              android:id="@+id/gtreset1"
              android:layout_width="@dimen/_80sdp"
              android:layout_height="@dimen/_40sdp"
              android:layout_gravity="center"
              android:background="@drawable/two_color3"
              android:clickable="true"
              android:elevation="@dimen/_5sdp"
              android:fontFamily="@font/kalpurush"
              android:foreground="?attr/selectableItemBackground"
              android:gravity="center"
              android:text="Reset"
              android:textColor="@color/white"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold" />

          <TextView
              android:id="@+id/gtcalculate"
              android:layout_width="@dimen/_100sdp"
              android:layout_height="@dimen/_40sdp"
              android:layout_gravity="center"
              android:layout_marginLeft="@dimen/_10sdp"
              android:background="@drawable/two_color3"
              android:clickable="true"
              android:fontFamily="@font/kalpurush"
              android:foreground="?attr/selectableItemBackground"
              android:gravity="center"
              android:text="Calculate"
              android:textColor="@color/white"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold" />

      </LinearLayout>

      <LinearLayout
        android:layout_width="@dimen/_250sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginRight="20sp"
        android:layout_marginLeft="20sp"
        android:background="@drawable/two_color"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_gravity="center"
        android:gravity="center"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listening Band Score"
            android:textColor="@color/white"
            android:textSize="@dimen/_22ssp"
            android:fontFamily="@font/kalpurush"
            android:textStyle="bold"
            android:layout_gravity="center"

            />

    </LinearLayout>

      <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/add_in_layout1"
          android:layout_width="@dimen/_250sdp"
          android:layout_height="wrap_content"
          style="@style/ThemeOverlay.Material3.AutoCompleteTextView"
          android:hint="Out of 40"
          android:layout_marginTop="@dimen/_7sdp"
          app:endIconMode="clear_text"
          app:boxStrokeWidth="@dimen/_2sdp"
          app:boxBackgroundColor="@color/white"
          android:paddingLeft="@dimen/_2sdp"
          android:paddingRight="@dimen/_2sdp"
          android:paddingTop="@dimen/_1sdp"
          android:paddingBottom="@dimen/_4sdp"
          android:background="@drawable/ac1"
          >

          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/gttext2"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="number"
              android:maxLength="2"
              android:textColor="#151515"
              android:textSize="@dimen/_13ssp" />


      </com.google.android.material.textfield.TextInputLayout>


    <LinearLayout
        android:layout_width="@dimen/_250sdp"
        android:layout_height="@dimen/_40sdp"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginTop="@dimen/_15sdp"
        >

        <TextView
            android:id="@+id/gtreset2"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/two_color3"
            android:gravity="center"
            android:layout_gravity="center"
            android:text="Reset"
            android:textColor="@color/white"
            android:textSize="@dimen/_20ssp"
            android:fontFamily="@font/kalpurush"
            android:textStyle="bold"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            />
        <TextView
            android:id="@+id/gtcalculate1"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center"
            android:background="@drawable/two_color3"
            android:gravity="center"
            android:text="Calculate"
            android:textColor="@color/white"
            android:textSize="@dimen/_20ssp"
            android:fontFamily="@font/kalpurush"
            android:textStyle="bold"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginLeft="@dimen/_10sdp"

            />

    </LinearLayout>

      <TextView
          android:layout_width="@dimen/_250sdp"
          android:layout_height="@dimen/_40sdp"
          android:text="Check Band score"
          android:textColor="@color/white"
          android:textStyle="bold"
          android:textSize="@dimen/_22ssp"
          android:fontFamily="@font/kalpurush"
          android:background="@drawable/two_color2"
          android:gravity="center"
          android:layout_gravity="center"
          android:layout_marginTop="@dimen/_20sdp"/>

      <LinearLayout
          android:layout_width="@dimen/_250sdp"
          android:layout_height="@dimen/_40sdp"
          android:layout_marginTop="@dimen/_10sdp"
          android:background="@drawable/ac1"
          android:orientation="horizontal"
          >

          <View
              android:layout_width="@dimen/_8sdp"
              android:layout_height="@dimen/_40sdp"
              android:background="@drawable/two_color"
              />

          <TextView
              android:layout_width="@dimen/_100sdp"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:layout_marginLeft="@dimen/_10sdp"
              android:fontFamily="@font/kalpurush"
              android:gravity="left"
              android:text="Reading"
              android:textColor="@color/black"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold"

              />

          <ImageView
              android:layout_width="@dimen/_22sdp"
              android:layout_height="@dimen/_30sdp"
              android:layout_gravity="center"
              android:src="@drawable/next_24"
              app:tint="#de0000" />

          <EditText
              android:id="@+id/gttext3"
              android:layout_width="@dimen/_80sdp"
              android:layout_height="@dimen/_40sdp"
              android:hint="Out of 9"
              android:inputType="numberDecimal"
              android:maxLength="3"
              android:textColor="#000000"
              android:textSize="@dimen/_20ssp"
              android:textStyle="normal"
              android:layout_marginLeft="@dimen/_10sdp"

              />


      </LinearLayout>

      <LinearLayout
          android:layout_width="@dimen/_250sdp"
          android:layout_height="@dimen/_40sdp"
          android:layout_marginTop="@dimen/_7sdp"
          android:background="@drawable/ac1"
          android:orientation="horizontal"

          >

          <View
              android:layout_width="@dimen/_8sdp"
              android:layout_height="@dimen/_40sdp"
              android:background="@drawable/two_color"

              />

          <TextView
              android:layout_width="@dimen/_100sdp"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:layout_marginLeft="@dimen/_10sdp"
              android:fontFamily="@font/kalpurush"
              android:gravity="left"
              android:text="Listening"
              android:textColor="@color/black"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold"
              />

          <ImageView
              android:layout_width="@dimen/_22sdp"
              android:layout_height="@dimen/_30sdp"
              android:layout_gravity="center"
              android:src="@drawable/next_24"
              app:tint="#de0000" />

          <EditText
              android:id="@+id/gttext4"
              android:layout_width="@dimen/_80sdp"
              android:layout_height="@dimen/_40sdp"
              android:hint="Out of 9"
              android:inputType="numberDecimal"
              android:maxLength="3"
              android:textColor="#000000"
              android:textSize="@dimen/_20ssp"
              android:textStyle="normal"
              android:layout_marginLeft="@dimen/_10sdp"
              />


      </LinearLayout>

      <LinearLayout
          android:layout_width="@dimen/_250sdp"
          android:layout_height="@dimen/_40sdp"
          android:layout_marginTop="@dimen/_7sdp"
          android:background="@drawable/ac1"
          android:orientation="horizontal"
          >

          <View
              android:layout_width="@dimen/_8sdp"
              android:layout_height="@dimen/_40sdp"
              android:background="@drawable/two_color"

              />

          <TextView
              android:layout_width="@dimen/_100sdp"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:layout_marginLeft="@dimen/_10sdp"
              android:fontFamily="@font/kalpurush"
              android:gravity="left"
              android:text="Writing"
              android:textColor="#2C2B2B"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold"
              />

          <ImageView
              android:layout_width="@dimen/_22sdp"
              android:layout_height="@dimen/_30sdp"
              android:layout_gravity="center"
              android:src="@drawable/next_24"
              app:tint="#de0000" />

          <EditText
              android:id="@+id/gttext5"
              android:layout_width="@dimen/_80sdp"
              android:layout_height="@dimen/_40sdp"
              android:hint="Out of 9"
              android:inputType="numberDecimal"
              android:maxLength="3"
              android:textColor="#000000"
              android:textSize="@dimen/_20ssp"
              android:textStyle="normal"
              android:layout_marginLeft="@dimen/_10sdp"
              />


      </LinearLayout>

      <LinearLayout
          android:layout_width="@dimen/_250sdp"
          android:layout_height="@dimen/_40sdp"
          android:layout_marginTop="@dimen/_7sdp"
          android:background="@drawable/ac1"
          android:orientation="horizontal"

          >

          <View
              android:layout_width="@dimen/_8sdp"
              android:layout_height="@dimen/_40sdp"
              android:background="@drawable/two_color"
              />

          <TextView
              android:layout_width="@dimen/_100sdp"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:layout_marginLeft="@dimen/_10sdp"
              android:fontFamily="@font/kalpurush"
              android:gravity="left"
              android:text="Speaking"
              android:textColor="#2C2B2B"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold"

              />

          <ImageView
              android:layout_width="@dimen/_22sdp"
              android:layout_height="@dimen/_30sdp"
              android:layout_gravity="center"
              android:src="@drawable/next_24"
              app:tint="#de0000" />

          <EditText
              android:id="@+id/gttext6"
              android:layout_width="@dimen/_80sdp"
              android:layout_height="@dimen/_40sdp"
              android:hint="Out of 9"
              android:inputType="numberDecimal"
              android:maxLength="3"
              android:textColor="#000000"
              android:textSize="@dimen/_20ssp"
              android:textStyle="normal"
              android:layout_marginLeft="@dimen/_10sdp"
              />


      </LinearLayout>

      <LinearLayout
          android:layout_width="@dimen/_250sdp"
          android:layout_height="@dimen/_40sdp"
          android:layout_marginTop="@dimen/_20sdp"
          android:layout_marginBottom="@dimen/_20sdp"
          android:orientation="horizontal"
          android:layout_gravity="center"
          android:gravity="center"
          >

          <TextView
              android:id="@+id/gtreset3"
              android:layout_width="@dimen/_80sdp"
              android:layout_height="@dimen/_40sdp"
              android:background="@drawable/two_color3"
              android:clickable="true"
              android:fontFamily="@font/kalpurush"
              android:foreground="?attr/selectableItemBackground"
              android:gravity="center"
              android:text="Reset"
              android:textColor="@color/white"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold" />

          <TextView
              android:id="@+id/gtcalculate2"
              android:layout_width="@dimen/_100sdp"
              android:layout_height="@dimen/_40sdp"
              android:layout_marginLeft="@dimen/_10sdp"
              android:background="@drawable/two_color3"
              android:clickable="true"
              android:fontFamily="@font/kalpurush"
              android:foreground="?attr/selectableItemBackground"
              android:gravity="center"
              android:text="Calculate"
              android:textColor="@color/white"
              android:textSize="@dimen/_20ssp"
              android:textStyle="bold" />


      </LinearLayout>








  </LinearLayout>




</ScrollView>